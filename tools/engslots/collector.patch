+        from types import SimpleNamespace
+        from unittest.mock import patch
+        spec = {"tracks": {"generalist": {}}}
+        engine = {"tracks": {"s1-fast": {"next_slot_utc": "2026-10-27T14:30:00Z"}}}
+        approvals = {"approved": []}
+        payload = (json.dumps({"miners": {}}) + "\n#SPEC#\n" + json.dumps(spec)
+                   + "\n#ENGINE#\n" + json.dumps(engine) + "\n#APPROVALS#\n" + json.dumps(approvals)
+                   + "\n#LOGS#\n").encode()
+        with patch.object(Path, "read_text", return_value="22 test-node"), patch.object(
+                collect.subprocess, "run", return_value=SimpleNamespace(returncode=0, stdout=payload)) as run:
+            state, lines = collect.fetch_node(None)
+        self.assertEqual(state["_spec"], spec)
+        self.assertEqual(state["_engine"], engine)
+        self.assertEqual(state["_approvals"], approvals)
+        self.assertEqual(lines, [])
+        self.assertIn(collect.ENGINE_STATE_FILE, run.call_args.args[0][-1])
