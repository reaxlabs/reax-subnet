+class EngineSlots(unittest.TestCase):
+    def test_engine_slot_and_pending_are_public(self):
+        slot = "2026-10-27T14:30:00+00:00"
+        pending = dict(uid=7, digest12="a"*12, pooled_score=2.0, slot_utc=slot,
+                       secret_session="must not leave collector", digest="a"*64)
+        state = {"tracks": {"s1-fast": {"next_slot_utc": slot, "pending": pending}}}
+        out = collect.competitions_doc(None, 1793100000, engine=state)["engine"]
+        self.assertEqual(out["next_slot_utc"], slot)
+        self.assertEqual(out["pending"], {k: pending[k] for k in ("uid", "digest12", "pooled_score", "slot_utc")})
+        self.assertNotIn("secret_session", str(out))
+
+    def test_old_or_missing_engine_state(self):
+        for state in (None, {}, {"tracks": {"s1-fast": {}}}):
+            out = collect.competitions_doc(None, 1793100000, engine=state)["engine"]
+            self.assertIsNone(out["next_slot_utc"])
+            self.assertIsNone(out["pending"])
+
+    def test_build_outputs_wires_engine_state(self):
+        import json
+        c = sqlite3.connect(":memory:")
+        c.executescript(Path(collect.__file__).read_text().split('c.executescript("""')[1].split('""")')[0])
+        state = {"miners": {}, "_engine": {"tracks": {"s1-fast": {"next_slot_utc": "2026-10-27T14:30:00Z"}}}}
+        out = collect.build_outputs(c, state, None, 1793100000)
+        self.assertEqual(json.loads(out["competitions.json"])["engine"]["next_slot_utc"], "2026-10-27T14:30:00Z")
+
+class EngineSlotDisplayAdvance(unittest.TestCase):
+    def test_no_winner_slot_advances_display_from_exported_calendar(self):
+        tue, fri = "2026-10-27T14:30:00+00:00", "2026-10-30T14:30:00+00:00"
+        from datetime import datetime
+        now = datetime.fromisoformat(tue).timestamp() + 1
+        state = {"tracks": {"s1-fast": {"next_slot_utc": tue, "crown_slots_utc": [tue, fri]}}}
+        out = collect.competitions_doc(None, now, engine=state)["engine"]
+        self.assertEqual(out["next_slot_utc"], fri)
+        state["tracks"]["s1-fast"].pop("crown_slots_utc")
+        self.assertIsNone(collect.competitions_doc(None, now, engine=state)["engine"]["next_slot_utc"])
+
