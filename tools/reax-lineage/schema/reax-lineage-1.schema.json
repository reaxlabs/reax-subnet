{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reax.example/schema/reax-lineage-1.schema.json",
  "title": "reax-lineage.json (v1, legacy: read as ONE parent with share 1; the licence enum is Apache-2.0 only since checker 1.6.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hotkey",
    "entry",
    "start",
    "own_models",
    "architecture_changes",
    "teachers",
    "datasets",
    "mentioned_not_used",
    "licence"
  ],
  "properties": {
    "schema": {
      "const": "reax-lineage/1"
    },
    "hotkey": {
      "type": "string",
      "pattern": "^5[1-9A-HJ-NP-Za-km-z]{46,47}$",
      "description": "ss58 address of the committing hotkey (RULES-v2 3.1)"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision"
      ],
      "properties": {
        "repo": {
          "$ref": "#/definitions/repo"
        },
        "revision": {
          "$ref": "#/definitions/sha"
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "list",
            "entry",
            "none"
          ]
        },
        "repo": {
          "$ref": "#/definitions/repo"
        },
        "revision": {
          "$ref": "#/definitions/sha"
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "repo"
                  ]
                },
                {
                  "required": [
                    "revision"
                  ]
                },
                {
                  "required": [
                    "uid"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "list",
                  "entry"
                ]
              }
            }
          },
          "then": {
            "required": [
              "repo",
              "revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "entry"
              }
            }
          },
          "then": {
            "required": [
              "uid"
            ]
          }
        }
      ]
    },
    "own_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "how"
        ],
        "properties": {
          "repo": {
            "$ref": "#/definitions/repo"
          },
          "revision": {
            "$ref": "#/definitions/sha"
          },
          "how": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "averaged_own_checkpoints": {
      "type": "boolean"
    },
    "architecture_changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layer_map": {
          "type": [
            "array",
            "object",
            "null"
          ],
          "description": "entry layer -> start layer (list index = entry layer, or {\"entry\": start})"
        },
        "pruned": {
          "type": [
            "object",
            "null"
          ]
        },
        "config_fields": {
          "type": "object",
          "description": "config.json fields that differ from the start, with the new values"
        },
        "quantisation_aware_training": {
          "type": "boolean"
        }
      }
    },
    "teachers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repo_or_api",
          "use"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repo_or_api": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "enum": [
              "distillation",
              "synthetic data",
              "labels",
              "preference",
              "judge"
            ]
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "licence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "approx_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mentioned_not_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "licence": {
      "enum": [
        "Apache-2.0"
      ]
    },
    "corrects": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"
    },
    "signature": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0x)?[0-9a-fA-F]{128}$",
      "description": "sr25519 over the canonical JSON (sorted keys, UTF-8, no whitespace, without this field); required for a correction"
    }
  },
  "definitions": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
