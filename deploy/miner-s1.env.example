# Common miner settings for deploy/docker-compose.s1.yml; the Compose file selects s1-fast.
# Copy to deploy/miner.env and fill in. The hotkey file is mounted, not pasted.
REAX_NETWORK=finney
REAX_NETUID=92
REAX_WALLET_NAME=<coldkey name>
REAX_WALLET_HOTKEY=<hotkey name>
REAX_EXTERNAL_IP=<public ip of this machine>
REAX_EXTERNAL_PORT=8091
REAX_MINER_PORT=8091

# Several models on one hotkey (from elements.MULTIMODEL_START_BLOCK; docs/MINER.md). One sidecar per model; each model
# has its own limits. Leave REAX_MODELS unset for the usual single-model miner (the Compose file sets REAX_MODEL).
# REAX_MODELS=s1-fast,s1-pro,s1-lite
# REAX_S1_FAST_RUNTIME_URL=http://127.0.0.1:8101
# REAX_S1_PRO_RUNTIME_URL=http://127.0.0.1:8102
# REAX_S1_LITE_RUNTIME_URL=http://127.0.0.1:8103
# multinode instead of a runtime URL: REAX_FEATURE_MULTINODE=1 with REAX_S1_FAST_WORKERS_FILE / REAX_S1_PRO_WORKERS_FILE
# Not before the start blocks: REAX_FORCE_MULTIROLE=1 (nobody scores a multi-model / two-element commitment earlier).
